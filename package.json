{
  "name": "yaad",
  "type": "module",
  "version": "2.4.2",
  "private": true,
  "description": "Gentle interval reminders — water, eyes, posture and your own tasks. Everything stays on your phone.",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run icons && astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{mjs,ts,json}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{mjs,ts,json}\" \"scripts/*.mjs\"",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.6",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "^7.3.8",
    "idb": "^8.0.4",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vite-pwa/astro": "^1.2.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
