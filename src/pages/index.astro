---
import '../styles/global.css';
// Preloaded so the first layout already has the real font (no fallback-font lookup, no layout shift).
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';

// Strict CSP: only same-origin files, no inline scripts or styles, no outside connections.
// Applied to production builds only (the Vite dev server needs inline scripts for hot reload).
const csp = [
  "default-src 'none'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self' blob:",
  "font-src 'self'",
  "connect-src 'self'",
  "worker-src 'self'",
  "manifest-src 'self'",
  "base-uri 'none'",
  "form-action 'none'",
  "object-src 'none'",
].join('; ');
const splashSizes = [
  [430, 932, 3],
  [393, 852, 3],
  [428, 926, 3],
  [390, 844, 3],
  [375, 812, 3],
  [414, 896, 2],
  [375, 667, 2],
  [768, 1024, 2],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="referrer" content="no-referrer" />
    <title>Yaad — gentle reminders</title>
    <meta name="description" content="Water, eyes, posture and your own task reminders, on a simple interval. Everything stays on your phone." />
    <meta name="theme-color" content="#f5f6fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1020" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Yaad" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    {
      splashSizes.map(([w, h, r]) => (
        <link
          rel="apple-touch-startup-image"
          href={`/icons/splash-${w}x${h}.png`}
          media={`(device-width: ${w}px) and (device-height: ${h}px) and (-webkit-device-pixel-ratio: ${r}) and (orientation: portrait)`}
        />
      ))
    }
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div id="app">
      <div class="splash" role="status" aria-label="Loading Yaad">
        <img src="/favicon.svg" alt="" width="64" height="64" />
        <p>Yaad</p>
      </div>
      <noscript><p class="p-6">Yaad needs JavaScript to run.</p></noscript>
    </div>
    <script>
      import '../main';
    </script>
  </body>
</html>
